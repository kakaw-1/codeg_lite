# Copy this file to .env for LOCAL docker compose only. Never commit .env.
# Generate a 24+ character random Codeg token on your own machine.
CODEG_TOKEN=PASTE_RANDOM_24_PLUS_CHARACTERS_HERE
TUNNEL_TOKEN=PASTE_YOUR_REMOTELY_MANAGED_CLOUDFLARE_TUNNEL_TOKEN_HERE

# Optional: local fast-disk primary for CODEG_DATA_DIR (ext4, ~1ms writes).
# CODEG_DATA_DIR itself stays on OSS (/mnt/workspace/...) as snapshot mirror.
# CODEG_LOCAL_DATA_DIR=/eas/workspace/codeg-data
# Snapshot interval in seconds (crash RPO). Graceful restarts lose nothing.
# CODEG_SNAPSHOT_INTERVAL_S=1
